"Indicates if this is the default method for user registration "
"authentication."
msgstr ""
"Indica si aquest és el mètode predeterminat per a l'autenticació de la "
"registració d'usuaris."

#. module: auth_signup_verify_phone
#. odoo-python
#: code:addons/auth_signup_verify_phone/controllers/main.py:0
#, python-format
msgid ""
"Invalid phone number format. Please use the format:<br/>+[Country "
"Code][Number]<br/>Example: +34612345758"
msgstr ""
"Format de número de telèfon no vàlid. Si us plau, utilitzeu el "
"format:<br/>+[Codi de país][Número]<br/>Exemple: +34612345758"

