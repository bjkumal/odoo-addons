msgstr "Método de autenticación de registro predeterminado"

#. module: auth_signup_verify_phone
#: model:ir.model.fields,help:auth_signup_verify_phone.field_mail_gateway__default_signup_auth_method
msgid ""
"Indicates if this is the default method for user registration "
"authentication."
msgstr ""
"Indica si este es el método predeterminado para la autenticación del "
"registro de usuarios."

#. module: auth_signup_verify_phone
#. odoo-python
#: code:addons/auth_signup_verify_phone/controllers/main.py:0
#, python-format
msgid ""
"Invalid phone number format. Please use the format:<br/>+[Country "
"Code][Number]<br/>Example: +34612345758"
msgstr ""
"Formato de número de teléfono inválido. Por favor use el "
"formato:<br/>+[Código de País][Número]<br/>Ejemplo: +34612345758"

