#. module: auth_signup_verify_phone
#. odoo-python
#: code:addons/auth_signup_verify_phone/models/mail_gateway.py:0
#, python-format
msgid ""
"Only one authentication method can be the default for user registration."
msgstr ""
"Sólo un método de autenticación puede ser el predeterminado para el "
"registro de usuarios."

#. module: auth_signup_verify_phone
#. odoo-python
#: code:addons/auth_signup_verify_phone/models/mail_whatsapp_template.py:0
